# FreeCAD backups and lock files
*.FCBak
*.FCStd1
.~lock.*

# Generated exports (built by CI as release assets, not committed)
out/

# External references cloned locally (license-incompatible or large)
refs/

# Python
__pycache__/
*.pyc
.venv/

# Generated locally: the census database and the viewer page. Safe to delete;
# the census scripts rebuild it.
build/

# Rebrickable snapshots, one folder per download date. Not safe to delete:
# Rebrickable allows one download a day, and older snapshots can't be fetched
# again.
downloads/
